# ─── Copy this to .env.local for local dev with Neon ─────────────────────────
#
# DATABASE_URL  — Neon pooled connection string (server-side only, no VITE_ prefix)
#                 Get from: https://console.neon.tech → your project → Connection Details → Pooled
DATABASE_URL=

# VITE_USE_DB   — set to "true" to switch from demo BroadcastChannel to Neon API
#                 Leave blank (or omit) for local 2-tab demo mode
VITE_USE_DB=true
